LOG_LEVEL=info

# --- Docker Compose infrastructure (read by docker-compose.yml) ---
POSTGRES_USER=studio
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=studio
POSTGRES_PORT=5432
REDIS_PORT=6379

